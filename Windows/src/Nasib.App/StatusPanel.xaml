<UserControl x:Class="Nasib.App.StatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Nasib.App"
             xmlns:drawing="clr-namespace:Nasib.App.Drawing">
    <!-- The output pane takes whatever height the taller Settings tab leaves, so the tab has no empty gap. -->
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <!-- App name and icon at the top of the Status tab. When a newer release exists, its button sits at the
                 trailing edge of this row, which is already as tall as the icon, so nothing below it moves. -->
            <DockPanel>
                <Button x:Name="UpdateButton"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Content="{Binding UpdateButtonTitle}"
                        Visibility="{Binding HasUpdate, Converter={StaticResource VisibleWhenTrue}}"
                        Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="{x:Static app:ToolTipText.UpdateToRelease}"
                        Click="OnUpdateClick" />
                <StackPanel Orientation="Horizontal">
                    <Image Source="{x:Static drawing:AppIconDrawing.ImageSource}"
                           Width="{x:Static app:DesignTokens.HeaderIconSize}"
                           Height="{x:Static app:DesignTokens.HeaderIconSize}" />
                    <TextBlock Text="Nasib" Style="{StaticResource TitleText}" Margin="{x:Static app:DesignTokens.InlineGap}" />
                </StackPanel>
            </DockPanel>

            <DockPanel Margin="{x:Static app:DesignTokens.SectionGap}" LastChildFill="True">
                <Ellipse DockPanel.Dock="Left"
                         Width="{x:Static app:DesignTokens.StatusDotSize}"
                         Height="{x:Static app:DesignTokens.StatusDotSize}"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.Kind}" Value="{x:Static app:ConnectionKind.Down}">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.Kind}" Value="{x:Static app:ConnectionKind.Searching}">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.Kind}" Value="{x:Static app:ConnectionKind.Connected}">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <ProgressBar DockPanel.Dock="Right"
                             IsIndeterminate="True"
                             Width="{x:Static app:DesignTokens.BusyIndicatorWidth}"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" />
                <TextBlock Text="{Binding State.Title}"
                           Style="{StaticResource HeadingText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="{x:Static app:DesignTokens.InlineGap}" />
            </DockPanel>

            <TextBlock Style="{StaticResource ErrorText}"
                       Margin="{x:Static app:DesignTokens.RowGap}"
                       Visibility="{Binding EngineMissing, Converter={StaticResource VisibleWhenTrue}}">
                <Run Text="The engine is missing. Keep nasib-engine.exe in the same folder as Nasib.exe:" />
                <Run Text="{Binding EnginePath, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource ErrorText}"
                       Margin="{x:Static app:DesignTokens.RowGap}"
                       Visibility="{Binding CliMissing, Converter={StaticResource VisibleWhenTrue}}">
                <Run Text="Windscribe is not installed, or its command-line tool is missing from" />
                <Run Text="{Binding CliPath, Mode=OneWay}" />
            </TextBlock>

            <!-- Tooltips also show on disabled buttons, so it is clear what each one would do. -->
            <DockPanel Margin="{x:Static app:DesignTokens.SectionGap}">
                <Button Content="{Binding FindButtonTitle}"
                        IsEnabled="{Binding CanUseFindButton}"
                        ToolTip="{Binding FindButtonToolTip}"
                        ToolTipService.ShowOnDisabled="True"
                        MinWidth="{x:Static app:DesignTokens.FindButtonMinWidth}"
                        Click="OnFindClick" />
                <Button Content="{Binding SurveyButtonTitle}"
                        IsEnabled="{Binding CanUseSurveyButton}"
                        ToolTip="{Binding SurveyButtonToolTip}"
                        ToolTipService.ShowOnDisabled="True"
                        Margin="{x:Static app:DesignTokens.InlineGap}"
                        Click="OnSurveyClick" />
                <Button Content="Show Log"
                        HorizontalAlignment="Right"
                        ToolTip="{x:Static app:ToolTipText.ShowLog}"
                        Click="OnShowLogClick" />
            </DockPanel>

            <Separator Margin="{x:Static app:DesignTokens.SectionGap}" />

            <CheckBox Content="Auto-reconnect when the tunnel drops"
                      IsChecked="{Binding AutoReconnect}"
                      ToolTip="{x:Static app:ToolTipText.AutoReconnect}"
                      Margin="{x:Static app:DesignTokens.RowGap}" />
            <CheckBox x:Name="LaunchAtLogin"
                      Content="Launch at login"
                      ToolTip="{x:Static app:ToolTipText.LaunchAtLogin}"
                      Margin="{x:Static app:DesignTokens.RowGap}"
                      Checked="OnLaunchAtLoginChanged"
                      Unchecked="OnLaunchAtLoginChanged" />
            <TextBlock x:Name="LoginItemError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        </StackPanel>

        <!-- The engine's recent output. The scroller sits on a Canvas, which asks for no space of its own, so
             new lines scroll inside the pane instead of making the window taller. -->
        <Border Margin="{x:Static app:DesignTokens.SectionGap}"
                MinHeight="{x:Static app:DesignTokens.LogHeight}"
                BorderThickness="{x:Static app:DesignTokens.HairlineThickness}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="{x:Static app:DesignTokens.ControlCornerRadius}"
                Padding="{x:Static app:DesignTokens.OutputPadding}">
            <Canvas x:Name="OutputCanvas">
                <ScrollViewer x:Name="OutputScroller"
                              Width="{Binding ActualWidth, ElementName=OutputCanvas}"
                              Height="{Binding ActualHeight, ElementName=OutputCanvas}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Colored by what the line reports; only "nothing worked" and a missing CLI use the error color.
                                     Every other line has a background stripe, counted from the first line shown, so it doesn't flip. -->
                                <Border Padding="{x:Static app:DesignTokens.LogLinePadding}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStriped}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Text}"
                                               FontFamily="{x:Static app:DesignTokens.MonospaceFontFamily}"
                                               FontSize="{x:Static app:DesignTokens.LogFontSize}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static app:OutputTone.Primary}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static app:OutputTone.Success}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static app:OutputTone.Muted}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static app:OutputTone.Warning}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static app:OutputTone.Error}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static app:OutputTone.Accent}">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static app:OutputTone.Phase}">
                                                        <Setter Property="Foreground" Value="{x:Static app:DesignTokens.PhaseBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Canvas>
        </Border>
    </DockPanel>
</UserControl>
