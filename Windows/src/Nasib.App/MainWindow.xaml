<Window x:Class="Nasib.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Nasib.App"
        Title="Nasib"
        Width="{x:Static app:DesignTokens.WindowWidth}"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="{x:Static app:DesignTokens.WindowPadding}">
        <TabControl x:Name="Tabs" SelectionChanged="OnTabSelectionChanged">
            <TabItem Header="Status" />
            <TabItem Header="Settings" />
        </TabControl>

        <!-- Only the chosen tab takes space, and the window takes its height and width: Settings is wider, so the
             two location lists sit side by side. -->
        <Grid Margin="{x:Static app:DesignTokens.SectionGap}">
            <app:StatusPanel x:Name="StatusPanel" />
            <app:SettingsPanel x:Name="SettingsPanel" VerticalAlignment="Top" Visibility="Collapsed" />
        </Grid>
    </StackPanel>
</Window>
