#!/bin/sh
# Stands in for windscribe-cli in the end-to-end tests. It keeps the tunnel state in $FAKE_CLI_DIR/state
# and logs every call to $FAKE_CLI_DIR/calls. Like the real app, a connect issued while a tunnel is up
# tears the old tunnel down and drops the new request. A "never_connects" marker file keeps every connect
# from coming up.
state_file="$FAKE_CLI_DIR/state"
state=$(cat "$state_file" 2>/dev/null || echo disconnected)
echo "$*" >>"$FAKE_CLI_DIR/calls"
case "$1" in
  status)
    if [ "$state" = connected ]; then
      echo "Connect state: Connected: Testville - Fake"
      echo "Protocol: IKEv2:500"
    else
      echo "Connect state: Disconnected"
    fi ;;
  connect)
    if [ "$state" = connected ]; then
      echo disconnected >"$state_file"
    elif [ ! -e "$FAKE_CLI_DIR/never_connects" ]; then
      echo connected >"$state_file"
    fi ;;
  disconnect)
    echo disconnected >"$state_file" ;;
esac
