#!/bin/sh
# Stands in for nasib-engine in the app's tests. The first argument picks what it does:
#   lines        prints three lines, then exits with 0
#   stop         prints "ready", waits for "stop" on its input, prints "stopped" and exits with 130
#   input-closed prints "ready", waits for its input to close, then writes "closed" to the file named by
#                the second argument and exits with 0
#   once         prints "connected: Lygos / tcp:443" with surrounding blank lines, then exits
#   hang         prints nothing and sleeps
case "$1" in
  lines)
    echo "phase: tcp on port 443"
    echo "trying: Lygos / tcp:443"
    echo "connected: Lygos / tcp:443"
    ;;
  stop)
    echo "ready"
    while read -r line; do
      if [ "$line" = "stop" ]; then
        echo "stopped"
        exit 130
      fi
    done
    ;;
  input-closed)
    echo "ready"
    while read -r line; do :; done
    sleep 1
    echo "closed" > "$2"
    ;;
  once)
    echo ""
    echo "connected: Lygos / tcp:443"
    echo ""
    ;;
  hang)
    sleep 60
    ;;
esac
